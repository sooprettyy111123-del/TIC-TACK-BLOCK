<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>BOTS OR HUMANS: Tic Tac BLOCK!</title>
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: #121212;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }
        h1 {
            font-size: 1.2rem;
            margin-bottom: 10px;
            text-align: center;
        }
        #status {
            font-size: 0.9rem;
            margin-bottom: 15px;
            color: #aaa;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 4px;
            background-color: #333;
            padding: 4px;
            border-radius: 8px;
            max-width: 95vw;
            max-height: 95vw;
        }
        .cell {
            width: 35px;
            height: 35px;
            background-color: #1e1e1e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            user-select: none;
        }
        .cell:active {
            background-color: #444;
        }
        .x { color: #ff5252; }
        .o { color: #448aff; }
        .block { background-color: #7c4dff; color: #fff; }
    </style>
</head>
<body>

    <h1>Tic Tac BLOCK!</h1>
    <div id="status">Current Turn: Player X</div>
    <div class="grid" id="board"></div>

    <script>
        const boardSize = 8;
        let board = Array(boardSize * boardSize).fill('');
        let currentPlayer = 'X';
        const players = ['X', 'O', 'B'];
        let playerIndex = 0;

        const boardElement = document.getElementById('board');
        const statusElement = document.getElementById('status');

        function createBoard() {
            boardElement.innerHTML = '';
            board.forEach((value, index) => {
                const cell = document.createElement('div');
                cell.classList.add('cell');
                if (value === 'X') cell.classList.add('x');
                if (value === 'O') cell.classList.add('o');
                if (value === 'B') cell.classList.add('block');
                cell.textContent = value;
                cell.addEventListener('click', () => makeMove(index));
                boardElement.appendChild(cell);
            });
        }

        function makeMove(index) {
            if (board[index] === '') {
                board[index] = players[playerIndex];
                playerIndex = (playerIndex + 1) % players.length;
                statusElement.textContent = `Current Turn: Player ${players[playerIndex]}`;
                createBoard();
            }
        }

        createBoard();
    </script>

</body>
</html>
